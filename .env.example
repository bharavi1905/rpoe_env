# RPOE Environment Configuration
# Copy this file to .env and fill in your actual values

# MANDATORY — API endpoint for the LLM
API_BASE_URL=

# MANDATORY — Model identifier to use for inference
MODEL_NAME=

# MANDATORY — Your Hugging Face / API key
HF_TOKEN=

# OPTIONAL — The name of the local image to use for the environment
# if using from_docker_image() method
LOCAL_IMAGE_NAME=
